# Telegram Bot Token
# Get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# To get your user ID, message @userinfobot on Telegram
# Leave empty to allow everyone (not recommended for production)
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Redis Configuration (optional, defaults are set in docker-compose.yml)
# REDIS_HOST=redis
# REDIS_PORT=6379

# Parser Configuration
# BATCH_SIZE=10

# Прокси для Investing.com, через запятую. Парсер держит один, пока сайт не ответит
# HTTP 429 или 403, и сразу переключается на следующий. Пусто — прямое соединение.
# INVESTING_PROXY=socks5://user:pass@1.2.3.4:8000,socks5://user:pass@5.6.7.8:8000
INVESTING_PROXY=

# Second bot (US/American exchanges via Investing.com)
US_TELEGRAM_BOT_TOKEN=your_us_bot_token_here
US_ALLOWED_USER_IDS=

